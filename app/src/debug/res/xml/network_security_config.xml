<?xml version="1.0" encoding="utf-8"?>
<!--
  只给**本机回环**开明文 HTTP，且只在 debug 构建里。

  为什么需要：`GamekeeDownloadAtomicityTest` 用本地 `ServerSocket` 造「声明了
  Content-Length、只发一小段就关连接」的**真实**截断响应 —— 那是断网时的真实形状，
  比 mock 有说服力。而 API 28+ 默认禁止明文，不豁免的话那些用例会因为**连不上**
  而「通过」，也就是假通过（实测踩过：成功用例失败、失败用例假过）。

  release 构建不含这份配置：`src/debug/` 不参与 release 变体。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 批量预解包用前台服务承载：十几分钟的 CPU 密集任务，不然息屏久了进程会被回收。
         dataSync 是这类「批量处理本地数据」的标准类型；DATA_SYNC 子权限是 API 34 起
         的要求，声明在低版本上无副作用。POST_NOTIFICATIONS 是 API 33 起通知的运行时
         权限 —— 拒绝只会让进度看不见，前台服务的保活效果不受影响。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 应用内自更新：拉起系统安装器装下载好的 APK（Android 8+ 还需用户在
         系统设置里授予「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:largeHeap="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BD2ModManager"
        tools:targetApi="31"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BD2ModManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SpinePreviewActivity"
            android:configChanges="orientation|screenSize"
            android:hardwareAccelerated="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <service
            android:name=".service.PrepackService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 转换/装入期间的前台服务。没有它，用户切到后台放着不管就会被系统回收，
             一批 mod 装到一半断掉。 -->
        <service
            android:name=".service.InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 更新包安装：DownloadManager 下的 APK 在应用专属目录里，交给系统
             安装器读需要走 FileProvider 授权 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>